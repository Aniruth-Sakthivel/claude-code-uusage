# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/

# PyInstaller build output (agent/entry.py -> dist/meterhouse.exe)
agent/build/
agent/dist/
agent/*.spec

# Locally-built agent wheels/sdists. Releases are published to PyPI by
# .github/workflows/publish-agent.yml, so a built artifact in the tree is a
# stale copy of something the registry already owns.
dist-test/

# Databases / local state
*.db
*.db-wal
*.db-shm
meterhouse.db

# Node / frontend
node_modules/
web/dist/
api/dist/
*.tsbuildinfo
*.local
# Not committed: this workspace has native-binary optional deps (lightningcss,
# esbuild, rollup). A lockfile generated on one OS records only that OS's
# variant, so a Windows-generated lockfile breaks Netlify's Linux build (see
# the "Cannot find module lightningcss.linux-x64-gnu.node" incident). Each
# environment resolves its own platform-correct deps via plain `npm install`.
package-lock.json

# Netlify
.netlify/

# Env / secrets
.env
.env.*
!.env.example

# OS / editor
.DS_Store
Thumbs.db
