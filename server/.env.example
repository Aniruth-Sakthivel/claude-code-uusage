# Copy to .env and fill in real values. Never commit .env.

# Supabase Postgres connection (Project Settings -> Database -> Connection string -> URI)
CLAUDEFLEET_DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres

# Supabase project (Project Settings -> API)
CLAUDEFLEET_SUPABASE_URL=https://[project-ref].supabase.co
CLAUDEFLEET_SUPABASE_ANON_KEY=
CLAUDEFLEET_SUPABASE_SERVICE_ROLE_KEY=
