# Copy to .env and fill in. Never commit the real values.

# Supabase Postgres — use the TRANSACTION POOLER (port 6543), not the direct
# db.<ref>.supabase.co host. Newer Supabase projects publish no DNS for direct
# connections, and serverless functions exhaust them anyway (one new backend
# connection per invocation).
#   Dashboard -> Connect -> Transaction pooler -> URI
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres

# Supabase project — Dashboard -> Settings -> API
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Local API port; NODE_ENV=production on deploy.
PORT=8000
NODE_ENV=development

# Public dashboard origin. Embedded in the generated one-click install script,
# so it must be the URL agents can actually reach. Netlify sets URL
# automatically, so this can be omitted there.
PUBLIC_URL=http://127.0.0.1:5173

# Fallback used by the installer when claudefleet-agent is not on PyPI.
AGENT_REPO_URL=https://github.com/YOUR-ORG/claude-code-uusage.git

# Dev only — on Netlify the API and dashboard share an origin, so leave empty.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
